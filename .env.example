# Server only — add in Vercel → Settings → Environment Variables
# NEVER commit .env or paste keys into chat

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Client (baked in at build) — Google Analytics 4 Measurement ID
# analytics.google.com → Admin → Data streams → Web → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
